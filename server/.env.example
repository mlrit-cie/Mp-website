# ── Runtime ──────────────────────────────────────────────
NODE_ENV=development
PORT=3001

# ── Database (PostgreSQL) ────────────────────────────────
# Format: postgresql://USER:PASSWORD@HOST:PORT/DB?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mlrit_project_hub?schema=public"

# ── Auth (JWT) — CHANGE THESE in any non-dev environment ──
JWT_ACCESS_SECRET="dev-access-secret-change-me"
JWT_REFRESH_SECRET="dev-refresh-secret-change-me"
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL_DAYS=7

# ── CORS (comma-separated allowlist of frontend origins) ──
CORS_ORIGINS="http://localhost:8080,http://localhost:8081"

# ── Signup policy ─────────────────────────────────────────
ALLOWED_EMAIL_DOMAIN="mlrit.ac.in"

# ── File storage (Phase 1 = local; switch to s3 later) ────
STORAGE_DRIVER="local"
UPLOAD_DIR="var/uploads"
# S3_BUCKET=
# S3_REGION=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_ENDPOINT=          # set for MinIO
